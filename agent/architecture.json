  "dependency_rules": [
    {
      "name": "generic_core_must_not_import_model_family_implementations",
      "source_roots": [
        "mirai/config",
        "mirai/core"
      ],
      "target_prefixes": [
        "mirai.core.models.lingbot_video",
        "mirai.vendors.lingbot_video",
        "mirai.core.models.magi2_preview",
        "mirai.vendors.magi2_preview"
      ],
      "exclude_globs": [
        "mirai/core/builtins.py",
        "mirai/core/models/lingbot_video/**",
        "mirai/core/models/magi2_preview/**",
        "**/contracts/**"
      ]
    },
    {
      "name": "native_runtime_must_not_import_diffusers",
      "source_roots": ["mirai/core"],
      "target_prefixes": ["diffusers"],
      "exclude_globs": ["**/contracts/**", "**/testbed/**"]
    }
  ],
  "forbidden_dependencies": [
    "core orchestration -> concrete model-family implementation",
    "stable core -> optional feature implementation",
    "runtime -> diffusers",
    "feature implementation -> sibling experimental feature"
  ]
}
